# --- Frontend (Angular) ---
# Unanchored so they match frontend/ as well as the repo root.
dist/
out-tsc/
coverage/
.angular/
node_modules/
yarn.lock
/.angular-cli.json
/.ng/
*.tsbuildinfo

# frontend/package-lock.json is intentionally committed (the Docker build
# uses `npm ci`, which requires it).

# --- Backend (Python) ---
# The built Angular app, copied here by the Docker build and by the e2e
# script so one origin serves both. Generated, never edited: a committed
# copy would shadow the real build with a stale bundle.
/backend/static/
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
# Local SQLite databases
*.db

# --- Environment / secrets ---
.env
!*.env.example

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright smoke-test output
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
