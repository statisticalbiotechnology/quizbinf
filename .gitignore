# --- Frontend (Angular) ---
# Unanchored so they match frontend/ as well as the repo root.
dist/
out-tsc/
coverage/
.angular/
node_modules/
yarn.lock
/.angular-cli.json
/.ng/
*.tsbuildinfo

# frontend/package-lock.json is intentionally committed (the Docker build
# uses `npm ci`, which requires it).

# --- Backend (Python) ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
# Local SQLite databases
*.db

# --- Environment / secrets ---
.env
!*.env.example

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
