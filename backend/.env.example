# Copy to .env for local development. Never commit real secrets.

# SQLite for quick local dev; Postgres in compose/production.
DATABASE_URL=sqlite:///./quizbinf.db

# Signs the session cookie — use a long random value in production.
SESSION_SECRET=dev-only-secret

# Used to build QR-code URLs and the OIDC redirect URI.
PUBLIC_BASE_URL=http://localhost:4200

# Comma-separated KTH usernames granted the teacher role.
TEACHER_USERNAMES=lukask

# Development-only login bypass. Refused when ENVIRONMENT=production.
MOCK_LOGIN=true
ENVIRONMENT=development

# KTH OIDC — fill in after client registration with KTH IT.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
